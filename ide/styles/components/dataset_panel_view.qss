#DatasetSplitter {
    border: 1px solid #EAEAEA;
    border-radius: 8px;
    background-color: #fff;
    height: 100%;
}

#DatasetSplitter::handle {
    background: #EAEAEA;
}

#DatasetSplitter::handle:horizontal {
    width: 10px;
    margin: 0 2px;
}

#DatasetScroll {
    border: none;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0);
}

#DatasetParams {
    background-color: #fff;
}
